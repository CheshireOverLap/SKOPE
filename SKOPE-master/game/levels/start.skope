// SKOPE Starting Map
// 기본 시작 씬 - 플레이어 스폰 + 조명
// Format: RON (Rusty Object Notation)

(
    entities: [
        // ============ Player Spawn ============
        (
            name: "PlayerSpawn",
            position: (x: 0.0, y: 0.0, z: 0.0),
            rotation: (x: 0.0, y: 0.0, z: 0.0),
            scale: (x: 1.0, y: 1.0, z: 1.0),
            component: PlayerSpawn,
        ),

        // ============ Camera ============
        (
            name: "MainCamera",
            position: (x: 5.0, y: -8.0, z: 4.0),
            rotation: (x: 25.0, y: 0.0, z: -30.0),
            scale: (x: 1.0, y: 1.0, z: 1.0),
            component: Camera(
                fov: 60.0,
                near: 0.1,
                far: 1000.0,
            ),
        ),

        // ============ Lighting ============
        // 태양광 (메인 디렉셔널 라이트)
        (
            name: "SunLight",
            position: (x: 0.0, y: 0.0, z: 50.0),
            rotation: (x: -50.0, y: 30.0, z: 0.0),
            scale: (x: 1.0, y: 1.0, z: 1.0),
            component: Light(
                light_type: Sun,
                light_energy: 2.0,
                light_color: (1.0, 0.98, 0.95),
            ),
        ),

        // 보조 환경광 (어두운 부분 채우기)
        (
            name: "FillLight",
            position: (x: -10.0, y: 10.0, z: 15.0),
            rotation: (x: -30.0, y: -45.0, z: 0.0),
            scale: (x: 1.0, y: 1.0, z: 1.0),
            component: Light(
                light_type: Sun,
                light_energy: 0.3,
                light_color: (0.7, 0.8, 1.0),
            ),
        ),

        // ============ Reference Objects ============
        // 1M 큐브 (스케일 참조용)
        (
            name: "ReferenceCube_1M",
            position: (x: 3.0, y: 0.0, z: 0.5),
            rotation: (x: 0.0, y: 0.0, z: 0.0),
            scale: (x: 1.0, y: 1.0, z: 1.0),
            component: StaticProp(
                has_collision: true,
                mesh: Some("#Cube"),
            ),
        ),

        // 2M 실린더 (캐릭터 높이 참조용)
        (
            name: "ReferenceCharacter_2M",
            position: (x: -3.0, y: 0.0, z: 1.0),
            rotation: (x: 0.0, y: 0.0, z: 0.0),
            scale: (x: 0.5, y: 0.5, z: 2.0),
            component: StaticProp(
                has_collision: false,
                mesh: Some("#Cylinder"),
            ),
        ),
    ],
)
