// Explosion Effect
// Full combat explosion with debris VAT, particles, and flash
(
    name: "explosion",
    duration: 3.0,
    loop_mode: Once,
    modules: [
        // Initial flash flipbook
        (
            type: "Flipbook",
            start_delay: 0.0,
            asset: "explosion_flash",
            offset: [0.0, 0.0, 0.0],
            scale: 3.0,
            speed: 2.0,
            color: [1.0, 0.9, 0.7, 1.0],
            emission: 5.0,
            billboard: "FullCameraFacing",
        ),
        // Debris VAT animation
        (
            type: "Vat",
            start_delay: 0.05,
            asset: "debris_scatter",
            offset: [0.0, 0.0, 0.0],
            scale: 1.0,
            speed: 1.0,
            color: [0.8, 0.7, 0.6, 1.0],
            vat_type: "Rigid",
        ),
        // Fire particles
        (
            type: "Particle",
            start_delay: 0.0,
            duration: 0.5,
            use_gpu: true,
            particle_count: 150,
            spawn_rate: 0.0,
            burst_count: 80,
            spawn_shape: (shape: "Sphere", radius: 0.5),
            lifetime: (min: 0.3, max: 0.8),
            velocity: (mode: "Radial", speed: (min: 5.0, max: 12.0)),
            size: (min: 0.1, max: 0.3),
            color_start: [1.0, 0.7, 0.2, 1.0],
            color_end: [1.0, 0.3, 0.0, 0.0],
            gravity: [0.0, -3.0, 0.0],
            force_fields: [],
            rotation_speed: (min: -3.0, max: 3.0),
            blend_mode: "Additive",
        ),
        // Smoke cloud
        (
            type: "Particle",
            start_delay: 0.1,
            duration: 2.0,
            use_gpu: false,
            particle_count: 100,
            spawn_rate: 40.0,
            burst_count: 20,
            spawn_shape: (shape: "Sphere", radius: 0.8),
            lifetime: (min: 1.5, max: 2.5),
            velocity: (mode: "Radial", speed: (min: 0.5, max: 2.0)),
            size: (min: 0.3, max: 0.8),
            size_over_lifetime: Some((
                keys: [
                    (0.0, 0.3),
                    (0.3, 1.0),
                    (1.0, 1.5),
                ],
            )),
            color_start: [0.3, 0.25, 0.2, 0.7],
            color_end: [0.15, 0.12, 0.1, 0.0],
            gravity: [0.0, 0.5, 0.0],
            force_fields: [
                (
                    type: "Turbulence",
                    strength: 1.0,
                    frequency: 0.8,
                    octaves: 3,
                ),
                (
                    type: "Drag",
                    coefficient: 0.5,
                ),
            ],
            rotation_speed: (min: -0.5, max: 0.5),
            blend_mode: "Alpha",
        ),
        // Sparks
        (
            type: "Particle",
            start_delay: 0.0,
            duration: 1.0,
            use_gpu: true,
            particle_count: 50,
            spawn_rate: 0.0,
            burst_count: 30,
            spawn_shape: (shape: "Point"),
            lifetime: (min: 0.5, max: 1.5),
            velocity: (
                mode: "Cone",
                direction: [0.0, 1.0, 0.0],
                angle: 1.2,
                speed: (min: 3.0, max: 8.0),
            ),
            size: (min: 0.01, max: 0.03),
            color_start: [1.0, 0.9, 0.5, 1.0],
            color_end: [1.0, 0.4, 0.1, 0.0],
            gravity: [0.0, -9.8, 0.0],
            force_fields: [],
            rotation_speed: (min: 0.0, max: 0.0),
            blend_mode: "Additive",
        ),
    ],
    events: [
        (
            name: "explode",
            time: 0.0,
            callback: Some("on_explosion"),
        ),
        (
            name: "screen_shake",
            time: 0.0,
            callback: Some("on_explosion_shake"),
        ),
        (
            name: "sound",
            time: 0.0,
            callback: Some("play_explosion_sound"),
        ),
    ],
)
